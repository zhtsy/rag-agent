# ============================================================
#  RAG Agent 环境变量样例
#  用法：cp .env.example .env，把 <...> 换成真实值
#  口令生成：python3 -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(32)))"
#  注意：docker-compose.yml 里已无口令字面量，全部由本文件插值；
#        .env 在 .gitignore 里，永远不要提交。
# ============================================================

# ---------- Neo4j（知识图谱） ----------
# 容器内用服务名 bolt://neo4j:7687；宿主机本地跑用 bolt://localhost:7687
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# 必填，两者必须是同一个值：
#   NEO4J_AUTH 给容器做初始化（只在首次空数据目录时生效）
#   NEO4J_PASSWORD 给后端连接用
NEO4J_PASSWORD=<32 位随机字母数字>
NEO4J_AUTH=neo4j/<与 NEO4J_PASSWORD 相同>

# ---------- MySQL（问答记录 / 反馈 / 后台） ----------
MYSQL_DATABASE=rag_qa
MYSQL_USER=rag_user
MYSQL_ROOT_PASSWORD=<32 位随机字母数字>
MYSQL_PASSWORD=<32 位随机字母数字>
# 容器内由 compose 用上面四项拼出 DATABASE_URL，通常不用单独设。
# 只有在宿主机直接跑脚本（不经容器）时才需要，取消注释并改成 127.0.0.1：
# DATABASE_URL=mysql+pymysql://rag_user:<口令>@127.0.0.1:3306/rag_qa?charset=utf8mb4

# ---------- 大模型 ----------
# 阶段1（工具决策）与复杂推理走 DeepSeek；生成走本地 Ollama
DEEPSEEK_API_KEY=<your-deepseek-api-key>
OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---------- 服务鉴权 ----------
# /chat/stream、/feedback、/feedback/stats 的访问令牌。留空时后端 fail-closed（503 而不是放行）。
# 也可以不写在这里，改为写到文件 /app/.rag_api_key（改完下次请求即生效，轮换不用重启）
RAG_API_KEY=
# 生成：openssl rand -hex 24
RAG_API_KEY_FILE=/app/.rag_api_key

# ---------- 并发闸门（改动后重启后端生效） ----------
# 同时在跑的流式请求上限。默认 4 = PERF.md 实测的饱和点（2 vCPU 突发性能型）。
# 调大的前提是先确认机器不是突发型实例，否则只是让每个请求都变慢。
RAG_MAX_CONCURRENT=4
# 排满后最多排队等多少秒，超时直接回 429（快速失败，不让请求无限期等待）
RAG_QUEUE_WAIT=8

# ---------- 检索行为（可调参数，改完重启后端生效） ----------
# 相关性门槛：rerank 原始 top1 低于它就判"知识库无相关内容"。
# 实测 OOD 问题 ≤0.05、正常题 ≥0.6，0.15 是中间的空档，不要为了"多召回"往下调
RAG_MIN_RELEVANT=0.15
# rerank 窗口。太小会截掉高分块（设成 6 曾把 T019 答废），10 是实测余量
RAG_RERANK_CANDIDATES=10
# 完整性兜底（answer_guard.py）：0 关闭
RAG_ANSWER_GUARD=1

# ---------- 可观测性 ----------
# 每个请求打一行 JSON（request_id + 分阶段耗时 + TTFT），关闭设为 0
RAG_TRACE_LOG=1
# 可选：同时落一份 JSONL，供 trace_stats.py 统计 P50/P95
RAG_TRACE_FILE=

# ---------- 记忆（见 README §4.9） ----------
# 持久化记忆总开关：0 则退化成纯进程内记忆（重启即忘）
RAG_MEMORY_STORE=1
# 评测会话（session_id 以 eval- 开头）是否也落库。
# 默认 0：否则同批题第二次跑会带着第一次的历史，分数虚高
RAG_MEMORY_EVAL_SESSIONS=0
# 长期记忆总开关：0 则不做用户画像抽取，也不注入
RAG_LTM_ENABLED=1
# 抽取用哪个模型：cloud=DeepSeek（默认）/ local=本地 Qwen
RAG_LTM_EXTRACT_PROVIDER=cloud
